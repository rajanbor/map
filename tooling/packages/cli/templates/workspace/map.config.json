{
  "version": {{schemaVersion}},
  "specVersion": "0.1",
  "project": {
    "name": {{projectName}},
    "createdAt": {{createdAt}},
    "languages": {{languages}}
  },
  "analysis": {
    "analyzers": {{analyzers}},
    "include": {{include}},
    "exclude": {{exclude}}
  },
  "registry": {
    "source": "default"
  },
  "tools": {
    "tokenOptimizer": {
      "budget": 12000,
      "include": ["**/*.md"],
      "exclude": ["reports/**", "cache/**"]
    }
  },
  "sources": ["**/*.md"],
  "targets": {{targets}},
  "agents": {{agents}},
  "profiles": {{profiles}}
}
