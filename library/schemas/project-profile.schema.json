{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rajanbor/map/main/library/schemas/project-profile.schema.json",
  "title": "MAP project profile",
  "description": "Output of the Project Profiler (map detect --json; summarized in map plan): detected stack and agents with file-level evidence.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "root",
    "project",
    "probable",
    "workspaces",
    "evidence",
    "traversal",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "map.project-profile"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/summary"
    },
    "probable": {
      "$ref": "#/$defs/summary"
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "manifests",
          "languages",
          "frameworks"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "manifests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "frameworks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "traversal": {
      "type": "object",
      "required": [
        "maxDepth",
        "maxDirectories",
        "directoriesVisited",
        "truncated"
      ],
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxDirectories": {
          "type": "integer",
          "minimum": 1
        },
        "directoriesVisited": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "languages",
        "frameworks",
        "infrastructure",
        "tooling",
        "agents"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "agents": {
          "type": "array",
          "items": {
            "enum": [
              "claude",
              "codex",
              "cursor",
              "copilot",
              "gemini"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "signal",
        "category",
        "certainty",
        "file",
        "detail"
      ],
      "properties": {
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "language",
            "framework",
            "infrastructure",
            "tooling",
            "agent"
          ]
        },
        "certainty": {
          "enum": [
            "confirmed",
            "probable"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
