{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rajanbor/map/main/library/schemas/skills-lock.schema.json",
  "title": "MAP skills lockfile",
  "description": "Contract for .map/skills.lock.json: installed Agent Skills pinned to immutable revisions.",
  "type": "object",
  "required": [
    "lockfileVersion",
    "skills"
  ],
  "properties": {
    "lockfileVersion": {
      "const": 1
    },
    "skills": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "$ref": "#/$defs/lockedSkill"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "type": {
          "enum": [
            "git",
            "local"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9-]*$": true
      },
      "additionalProperties": false
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!(?:.*/)?\\.\\.?(?:/|$))(?!.*//)[^\\\\\\u0000-\\u001f]+$"
    },
    "lockedSkill": {
      "type": "object",
      "required": [
        "source",
        "path",
        "revision",
        "integrity",
        "scope",
        "targets",
        "files",
        "approvals"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|sha256-[0-9a-f]{64})$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "project"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "dir",
              "agents"
            ],
            "properties": {
              "dir": {
                "type": "string",
                "pattern": "^\\.[a-z]+/skills$"
              },
              "agents": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "copilot",
                    "gemini"
                  ]
                }
              }
            },
            "patternProperties": {
              "^x-[a-z0-9][a-z0-9-]*$": true
            },
            "additionalProperties": false
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "approvals": {
          "type": "object",
          "required": [
            "scripts",
            "risky"
          ],
          "properties": {
            "scripts": {
              "type": "boolean"
            },
            "risky": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9-]*$": true
      },
      "additionalProperties": false
    }
  }
}
